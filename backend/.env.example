# Servidor
PORT=8080

# Conta IMVU usada pelo backend (nao commitar a .env real)
IMVU_USER=seu_usuario_imvu
IMVU_PASS=sua_senha_imvu

# Origem permitida: * ou uma lista separada por virgula
CORS_ORIGIN=*

# Limites de recurso
MAX_WATCHERS=20
TARGET_ROOM_SCAN=800
OWN_ROOM_SCAN=120

# Web Push (VAPID) - gere com: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=sua_chave_publica
VAPID_PRIVATE_KEY=sua_chave_privada
VAPID_SUBJECT=mailto:seu_email
SITE_URL=https://seu-frontend
ALERT_TTL_MS=7200000
MAX_ALERTS=30

# ---------------- Music Bot / Radio ----------------
# true = bloqueia somente o bot de música (tracker continua normal)
BOT_MAINTENANCE=false

# URL publica do backend para o stream MP3.
# No Render, RENDER_EXTERNAL_URL e usada automaticamente; defina so se usar outro dominio/proxy.
PUBLIC_BASE_URL=https://seu-backend.onrender.com
# Segredo do token do stream (opcional; se vazio, aleatorio por processo)
RADIO_SECRET=

# Conta separada do rastreador (recomendado)
BOT_EMAIL=seu_email_do_bot@gmail.com
BOT_PASSWORD=sua_senha_do_bot
BOT_USERNAME=nome_do_bot
# 1 = permite usar a mesma conta do rastreador (segunda sessao; use por sua conta e risco)
BOT_ALLOW_SAME_ACCOUNT=0
BOT_SEND_INTERVAL_MS=1500
